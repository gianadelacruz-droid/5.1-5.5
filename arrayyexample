public class ArrayExample {
    public static void main(String[] args) {
        // Step 1: Declare
        int[] ages;

        // Step 2: Create (instantiate) — size 5
        ages = new int[5];

        // Step 3: Assign values
        ages[0] = 18;
        ages[1] = 19;
        ages[2] = 20;
        ages[3] = 21;
        ages[4] = 22;

        // Step 4: Print using .length
        for (int i = 0; i < ages.length; i++) {
            System.out.println("ages[" + i + "] = " + ages[i]);
        }
    }
}
